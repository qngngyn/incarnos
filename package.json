    "import:weapons": "node tools/import-weapons.mjs",
    "pack:weapons": "node tools/pack.mjs weapons",
    "sync:vault": "node tools/sync-vault.mjs",
    "import:talents": "node tools/import-talents.mjs",
    "import:races": "node tools/import-races.mjs",
    "import:monsters": "node tools/import-monsters.mjs",
    "pack:talents": "node tools/pack.mjs talents",
    "pack:races": "node tools/pack.mjs races",
    "pack:monsters": "node tools/pack.mjs monsters"
  },
  "browserslist": [
    "last 3 versions"
  ],
