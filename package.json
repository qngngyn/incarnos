{
  "name": "incarnos",
  "version": "1.0.0",
  "description": "CSS compiler for the Incarnos system",
  "scripts": {
    "build": "gulp build",
    "compile": "gulp css",
    "watch": "gulp",
    "gulp": "gulp",
    "import:spells": "node tools/import-spells.mjs",
    "pack:spells": "node tools/pack.mjs spells",
